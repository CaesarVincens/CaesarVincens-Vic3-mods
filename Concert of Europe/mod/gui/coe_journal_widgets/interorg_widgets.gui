		#	blockoverride "interorg_detail_3_visibility" {
		#		visible = "No"
		#	}
		#}
		#coe_concert_of_europe_reason = { }
		coe_concert_tabs = { }
		coe_concert_of_europe_buttons = { }
		coe_concert_of_europe_modifiers = { }
		coe_concert_members = { }
		#coe_spheres = {
			#blockoverride "text" {
			#	text = "coe_gui_inner_spheres"
			#}
		#	blockoverride "coe_sphere_datamodel" {
		#		datamodel = "[Country.MakeScope.GetList('coe_inner_sphere')]"
		#	}
		#}
		#coe_spheres = {
		#	blockoverride "text" {
		#		text = "COE_COUNTRY_OUTER_SPHERE"
		#	}
		#	blockoverride "coe_sphere_datamodel" {
		#		datamodel = "[Country.MakeScope.GetList('coe_outer_sphere')]"
		#	}
		#}
	}
}

####---------- INTERNATIONAL ORGANIZATION GUI TYPES ----------####
types coe_concert_of_europe_types {

	type coe_concert_of_europe_header = widget {
		block "spacer_size" {
			size = { 540 30 }
		}
	}

	type coe_base_panel = widget {
		size = { 560 274 }
		visible = "[ComJournalVar('coe_ruler_0').IsSet]"
		widget = {
			size = { 556 274 }
			parentanchor = hcenter

			### OVERVIEW BACKGROUND
			background = {
				block "interorg_backdrop_texture" {
					texture = "gfx/interface/character_panel/backgrounds/char_role_politician.dds"
				}
				fittype = centercrop
				using = frame_small_mask
			}

			background = {
				using = simple_frame
			}

			### CHARACTERS
			# BLOC MEMBER 4
			# MEMBER AVAILABLE
			container = {
				visible = "[ComJournalVar('coe_ruler_3').IsSet]"
				parentanchor = hcenter
				position = { -210 15 }
				maximumsize = { 100 265 } # This maximumsize is to make the button for this portrait not overlap the other character's buttons

				character_portrait_base = {
					parentanchor = hcenter
					datacontext = "[ComJournalVar('coe_country_3').GetCountry.GetRuler]"

					size = { 250 270 }

					blockoverride "portrait_size" {
						block "character_portrait_size" {
							size = { 265 265 }
						}
					}

					blockoverride "portrait_texture" {
						portrait_texture = "[Character.GetAnimatedPortrait('characters_portrait_environment', 'camera_event_right', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					}

					blockoverride "portrait_icons" {}
					blockoverride "tooltip" {}
					blockoverride "show_hat" {}
					blockoverride "highlight" {}

					blockoverride "portrait_button" {
						button = {
							parentanchor = hcenter
							size = { 100% 100% }

							block "portrait_button_onclick" {
								onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
							}

							block "portrait_button_onrightclick" {
								onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
							}

							onmousehierarchyenter = "[AccessHighlightManager.HighlightCharacter( ComJournalVar('coe_country_3').GetCountry.GetRuler )]"
							onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
						}
					}
				}
			}

			# NO FOURTH MEMBER AVAILABLE
			widget = {
				visible = "[Not( ComJournalVar('coe_ruler_3').IsSet)]"

				parentanchor = hcenter
				size = { 280 280 }
				position = { -210 15 }

				icon = {
					size = { 260 260 }
					texture = "gfx/interface/power_blocs/bloc_no_member.dds"
					alpha = 1
				}
			}

			### BLOC MEMBER 2
			# MEMBER AVAILABLE
			container = {
				visible = "[ComJournalVar('coe_ruler_1').IsSet]"
				parentanchor = hcenter
				position = { -110 15 }
				maximumsize = { 100 265 } # This maximumsize is to make the button for this portrait not overlap the other character's buttons

				character_portrait_base = {
					parentanchor = hcenter
					datacontext = "[ComJournalVar('coe_country_1').GetCountry.GetRuler]"

					size = { 250 265 }

					blockoverride "portrait_size" {
						block "character_portrait_size" {
							size = { 280 280 }
						}
					}

					blockoverride "portrait_texture" {
						portrait_texture = "[Character.GetAnimatedPortrait('characters_portrait_environment', 'camera_event_right', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					}

					blockoverride "portrait_mask" {
						mask = "gfx/interface/portraits/portrait_mask_small_fade_bottom.dds"
					}

					blockoverride "portrait_icons" {}
					blockoverride "tooltip" {}
					blockoverride "show_hat" {}
					blockoverride "highlight" {}

					blockoverride "portrait_button" {
						button = {
							parentanchor = hcenter
							size = { 100% 100% }

							block "portrait_button_onclick" {
								onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
							}

							block "portrait_button_onrightclick" {
								onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
							}

							onmousehierarchyenter = "[AccessHighlightManager.HighlightCharacter( ComJournalVar('coe_country_1').GetCountry.GetRuler )]"
							onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
						}
					}
				}
			}

			# NO SECOND MEMBER AVAILABLE
			widget = {
				visible = "[Not( ComJournalVar('coe_ruler_1').IsSet)]"
				parentanchor = hcenter
				size = { 280 280 }
				position = { -110 5 }

				icon = {
					size = { 280 280 }
					texture = "gfx/interface/power_blocs/bloc_no_member.dds"
					alpha = 1
				}
			}

			### BLOC MEMBER 5
			# MEMBER AVAILABLE
			container = {
				visible = "[ComJournalVar('coe_ruler_4').IsSet]"
				parentanchor = hcenter
				position = { 210 15 }
				maximumsize = { 100 265 } # This maximumsize is to make the button for this portrait not overlap the other character's buttons

				character_portrait_base = {
					parentanchor = hcenter
					datacontext = "[ComJournalVar('coe_country_4').GetCountry.GetRuler]"

					size = { 250 270 }

					blockoverride "portrait_size" {
						block "character_portrait_size" {
							size = { 265 265 }
						}
					}

					blockoverride "portrait_texture" {
						portrait_texture = "[Character.GetAnimatedPortrait('characters_portrait_environment', 'camera_event_left', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					}

					blockoverride "portrait_icons" {}
					blockoverride "tooltip" {}
					blockoverride "show_hat" {}
					blockoverride "highlight" {}

					blockoverride "portrait_button" {
						button = {
							parentanchor = hcenter
							size = { 100% 100% }

							block "portrait_button_onclick" {
								onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
							}

							block "portrait_button_onrightclick" {
								onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
							}

							onmousehierarchyenter = "[AccessHighlightManager.HighlightCharacter( ComJournalVar('coe_country_4').GetCountry.GetRuler )]"
							onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
						}
					}
				}
			}

			# NO FIFTH MEMBER AVAILABLE
			widget = {
				visible = "[Not(ComJournalVar('coe_ruler_4').IsSet)]"
				parentanchor = hcenter
				size = { 280 280 }
				position = { 210 15 }

				icon = {
					size = { 260 260 }
					texture = "gfx/interface/power_blocs/bloc_no_member.dds"
					mirror = horizontal
					alpha = 1
				}
			}

			### BLOC MEMBER 3
			# MEMBER AVAILABLE
			container = {
				visible = "[ComJournalVar('coe_ruler_2').IsSet]"
				parentanchor = hcenter
				position = { 110 15 }
				maximumsize = { 100 265 } # This maximumsize is to make the button for this portrait not overlap the other character's buttons

				character_portrait_base = {
					parentanchor = hcenter
					datacontext = "[ComJournalVar('coe_country_2').GetCountry.GetRuler]"

					size = { 250 265 }

					blockoverride "portrait_size" {
						block "character_portrait_size" {
							size = { 280 280 }
						}
					}

					blockoverride "portrait_texture" {
						portrait_texture = "[Character.GetAnimatedPortrait('characters_portrait_environment', 'camera_event_left', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					}

					blockoverride "portrait_icons" {}
					blockoverride "tooltip" {}
					blockoverride "show_hat" {}
					blockoverride "highlight" {}

					blockoverride "portrait_button" {
						button = {
							parentanchor = hcenter
							size = { 100% 100% }

							block "portrait_button_onclick" {
								onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
							}

							block "portrait_button_onrightclick" {
								onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
							}

							onmousehierarchyenter = "[AccessHighlightManager.HighlightCharacter( ComJournalVar('coe_country_2').GetCountry.GetRuler )]"
							onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
						}
					}
				}
			}

			# NO THIRD MEMBER AVAILABLE
			widget = {
				visible = "[Not(ComJournalVar('coe_ruler_2').IsSet)]"
				parentanchor = hcenter
				size = { 280 280 }
				position = { 110 5 }

				icon = {
					size = { 280 280 }
					texture = "gfx/interface/power_blocs/bloc_no_member.dds"
					mirror = horizontal
					alpha = 1
				}
			}

			### BLOC MEMBER 1 (LEADER)
			container = {
				parentanchor = hcenter
				maximumsize = { 100 265 } # This maximumsize is to make the button for this portrait not overlap the other character's buttons
				visible = "[ComJournalVar('coe_ruler_0').IsSet]"
				datacontext = "[ComJournalVar('coe_country_0').GetCountry.GetRuler]"

				character_portrait_base = {
					parentanchor = hcenter
					size = { 250 265 }

					blockoverride "portrait_size" {
						block "character_portrait_size" {
							size = { 300 300 }
						}
					}

					blockoverride "portrait_position" {
						position = { 0 15 }
					}

					blockoverride "portrait_texture" {
						portrait_texture = "[Character.GetAnimatedPortrait('pop_environment', 'camera_body', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					}

					blockoverride "portrait_icons" {}
					blockoverride "tooltip" {}
					blockoverride "show_hat" {}
					blockoverride "highlight" {}

					blockoverride "portrait_button" {
						button = {
							parentanchor = hcenter
							size = { 100% 100% }

							block "portrait_button_onclick" {
								onclick = "[InformationPanelBar.OpenCharacterPanel(Character.AccessSelf)]"
							}

							block "portrait_button_onrightclick" {
								onrightclick = "[RightClickMenuManager.ShowForCharacter(Character.AccessSelf)]"
							}

							onmousehierarchyenter = "[AccessHighlightManager.HighlightCharacter( ComJournalVar('coe_country_0').GetCountry.GetRuler )]"
							onmousehierarchyleave = "[AccessHighlightManager.RemoveHighlight]"
						}
					}
				}
			}

			### FLAGS
			#BLOC MEMBER 1 FLAG
			small_flag = {
				visible = "[ComJournalVar('coe_ruler_0').IsSet]"
				datacontext = "[ComJournalVar('coe_country_0').GetCountry]"
				position = { 0 -20 }
				parentanchor = hcenter|bottom
			}

			#BLOC MEMBER 2 FLAG
			tiny_flag = {
				visible = "[ComJournalVar('coe_ruler_1').IsSet]"
				position = { -110 -20 }
				parentanchor = hcenter|bottom
				datacontext = "[ComJournalVar('coe_country_1').GetCountry]"
			}

			#BLOC MEMBER 3 FLAG
			tiny_flag = {
				visible = "[ComJournalVar('coe_ruler_2').IsSet]"
				position = { 110 -20 }
				parentanchor = hcenter|bottom
				datacontext = "[ComJournalVar('coe_country_2').GetCountry]"
			}

			#BLOC MEMBER 4 FLAG
			tiny_flag = {
				visible = "[ComJournalVar('coe_ruler_3').IsSet]"
				position = { -210 -20 }
				parentanchor = hcenter|bottom
				datacontext = "[ComJournalVar('coe_country_3').GetCountry]"
			}

			#BLOC MEMBER 5 FLAG
			tiny_flag = {
				visible = "[ComJournalVar('coe_ruler_4').IsSet]"
				position = { 210 -20 }
				parentanchor = hcenter|bottom
				datacontext = "[ComJournalVar('coe_country_4').GetCountry]"
			}
		}
	}
	type coe_concert_tabs = flowcontainer {
		parentanchor = top|hcenter
		direction = horizontal
		minimumsize = { 540 40 }
		### START DIVIDER
		icon = {
			texture = "gfx/interface/tabs/tab_divider.dds"
			layoutpolicy_horizontal = fixed
			layoutpolicy_vertical = expanding
			size = { 5 -1 }
			spriteType = Corneredstretched
			spriteborder = { 0 20 }
		}

		# OVERVIEW TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[And(Not(GetVariableSystem.HasValue('coe_concert_tab', 'overview')), GetVariableSystem.Exists('coe_concert_tab'))]"
			textbox = {
				text = "coe_gui_overview_header"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('coe_concert_tab', 'overview')]"
			tooltip = "TAB_1"
			input_action = "tab_1"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[Or(GetVariableSystem.HasValue('coe_concert_tab', 'overview'), Not(GetVariableSystem.Exists('coe_concert_tab')))]"
			
			textbox = {
				text = "coe_gui_overview_header"
				default_format = "#variable"
				using = tab_text_properties
			}
		}

		# Player TAB
		tab_button = {
			minimumsize = { 108 -1 }
			visible = "[Not(GetVariableSystem.HasValue('coe_concert_tab', 'player'))]"
			textbox = {
				text = "coe_gui_canon_law_player"
				default_format = "#title"
				using = tab_text_properties
			}
			
			onclick = "[GetVariableSystem.Set('coe_concert_tab', 'player')]"
			tooltip = "TAB_2"
			input_action = "tab_2"
			using = tooltip_above
			
		}
		icon = {
			minimumsize = { 108 -1 }
			using = selected_tabs
			visible = "[GetVariableSystem.HasValue('coe_concert_tab', 'player')]"
			
			textbox = {
				text = "coe_gui_canon_law_player"
				default_format = "#variable"
				using = tab_text_properties
			}
		}
	}
	type coe_concert_of_europe_panel = widget {
		# FRAME SIZE
		size = { 530 300 }
		parentanchor = hcenter
		using = Animation_Character_Panel_Refresh

		# BACKGROUND
		block "interorg_background" {
			background = {
				block "interorg_backdrop_texture" {
					texture = "gfx/interface/character_panel/backgrounds/char_role_politician.dds"
				}
				fittype = centercrop
				using = frame_small_mask
			}
		}

		### ORGANIZATION CHAIR
		character_portrait_base_no_mask = {
			parentanchor = left|vcenter
			ignore_in_debug_draw = yes
			size = { 340 340 }
			max_update_rate = 24

			visible = "[ComJournalVar('com_interorg_chair_var').IsSet]"
			datacontext = "[ComJournalVar('com_interorg_chair_var').GetCharacter]"

			block "character_layout" {
				position = { -54 -16 }
			}
			blockoverride "portrait_size" {
				block "character_portrait_size" {
					size = { 340 340 }
				}
			}
			blockoverride "portrait_texture" {
				datacontext = "[ComJournalVar('com_interorg_chair_var')]"
				portrait_texture = "[Scope.GetCharacter.GetAnimatedPortrait(
					'ruler_environment',
					'camera_body',
					'idle',
					GetPortraitRenderSize(PdxGuiWidget.Self))
				]"
			}
			blockoverride "portrait_icons" { }
			blockoverride "tooltip" {
				block "interorg_leader_tooltip" {

				}
			}
		}

		flowcontainer = {
			direction = vertical
			parentanchor = bottom|left
			position = { 0 -20 }
			spacing = 5
			margin = { 5 5 }
			margin_left = 15

			visible = "[ComJournalVar('com_interorg_chair_var').IsSet]"
			datacontext = "[ComJournalVar('com_interorg_chair_var').GetCharacter]"

			background = {
				using = dark_area
				alpha = 0.75

				modify_texture = {
					texture = "gfx/interface/masks/fade_horizontal_right.dds"
					blend_mode = alphamultiply
				}
			}

			flowcontainer = {
				direction = horizontal
				spacing = 5

				icon = {
					size = { 35 35 }
					parentanchor = vcenter
					block "interorg_leader_icon" {
						visible = no
						texture = "gfx/interface/icons/alert_icons/formable_possible.dds"
					}
				}

				flowcontainer = {
					direction = vertical

					textbox = {
						layoutpolicy_horizontal = expanding
						size = { 200 18 }
						block "interorg_leader_title" {
							text = "com_gui_interorg_character_header"
						}
						align = left|nobaseline
						elide = right
						fontsize_min = 12
					}
					textbox = {
						layoutpolicy_horizontal = expanding
						size = { 200 20 }
						block "interorg_leader_name" {
							text = "com_gui_interorg_character_name"
						}
						align = left|nobaseline
						elide = right
						fontsize_min = 12
						using = fontsize_large
					}
				}
			}

		}

		coe_concert_of_europe_details = { }

		# TOP/BOTTOM FADE
		icon = {
			using = dark_area
			parentanchor = top|hcenter
			size = { 100% 15% }
			alpha = 0.65
			position = { 0 2 }

			modify_texture = {
				texture = "gfx/interface/masks/fade_vertical_bottom.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}
		icon = {
			using = dark_area
			parentanchor = bottom|hcenter
			size = { 100% 12% }
			alpha = 0.65
			position = { 0 2 }

			modify_texture = {
				texture = "gfx/interface/masks/fade_vertical_top.dds"
				spriteType = Corneredstretched
				spriteborder = { 0 0 }
				blend_mode = alphamultiply
			}
		}

		com_organizations_panel_button = {
			parentanchor = top|left
			position = { 20 20 }
		}

		# FRAME
		widget = {
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/character_panel/char_bg_frame.dds"
				margin_left = 18
				margin_right = 12
				margin_bottom = 10
				spriteType = Corneredtiled

				spriteborder_left = 200
				spriteborder_right = 60
				spriteborder_top = 170
				spriteborder_bottom = 180

				texture_density = 2
			}
		}

		## JOURNAL ICON
		block "interorg_journal_icon" {
			widget = {
				parentanchor = top|hcenter
				size = { 150 150 }
				position = { 0 -50 }
				icon = {
					parentanchor = center
					size = { 150 150 }
					position = { 2 2 }
					texture = "gfx/interface/backgrounds/com_bg_pb_frame.dds"
				}
				icon = {
					parentanchor = center
					size = { 150 150 }
					block "interorg_icon_frame_texture" {
						texture = "gfx/coat_of_arms/textured_emblems/pb_frame_04.dds"
					}
				}
				icon = {
					parentanchor = center
					texture = "[JournalEntry.GetIcon]"
					block "journal_icon_position" {
						position = { 0 -10 }
					}
					block "journal_icon_size" {
						size = { 75 75 }
					}
				}
			}
		}
	}

	type coe_concert_of_europe_details = flowcontainer {
		parentanchor = right|vcenter
		position = { 0 5 }
		direction = vertical
		spacing = 5
		margin_right = 13

		background = {
			using = dark_area
			alpha = 0.75

			modify_texture = {
				texture = "gfx/interface/masks/fade_horizontal_left_full.dds"
				blend_mode = alphamultiply
			}
		}

		### LEADER/HOST COUNTRY
		widget = {
			size = { 200 50 }

			block "interorg_detail_1_visibility" {
				visible = "[ComJournalVar('com_interorg_leader_var').IsSet]"
			}

			divider_clean = {
				parentanchor = bottom
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 7

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 0 5 }

					textbox = {
						layoutpolicy_horizontal = expanding
						size = { 0 16 }
						block "interorg_detail_1_name" {
							text = "com_gui_interorg_leader_header"
						}
						align = right|nobaseline
						elide = right
						fontsize_min = 12
					}
					textbox = {
						layoutpolicy_horizontal = expanding
						size = { 0 20 }
						block "interorg_detail_1_content" {
							text = "com_gui_interorg_leader_name"
						}
						align = right|nobaseline
						elide = right
						fontsize_min = 12
						using = fontsize_large
					}
				}

				icon = {
					size = { 35 35 }
					block "interorg_detail_1_texture" {
						texture = "gfx/interface/icons/alert_icons/formable_possible.dds"
					}
				}
			}
		}

		## HEADQUARTERS LOCATION
		widget = {
			size = { 200 50 }

			block "interorg_detail_2_visibility" {
				visible = "[ComJournalVar('com_interorg_headquarters_var').IsSet]"
			}

			divider_clean = {
				parentanchor = bottom
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				spacing = 7

				vbox = {
					layoutpolicy_horizontal = expanding
