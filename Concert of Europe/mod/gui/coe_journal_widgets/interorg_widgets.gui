	type com_organizations_panel_button = button_icon_round {
		size = { 50 50 }
		using = tooltip_above

		block "com_interorg_button_visible" {
			visible = "no"
		}
		blockoverride "icon" {
			texture = "gfx/interface/icons/notification_icons/journal.dds"
		}
		blockoverride "icon_size" {
			size = { 60% 60% }
		}

		onclick = "[GetVariableSystem.Set('com_open_window', 'com_international_organizations_sgui')]"
		tooltip = "com_gui_goto_international_orgs_panel"
	}

	type coe_concert_of_europe_reason = textbox {
		autoresize = yes
		block "interorg_reason_text" {
			text = "[JournalEntry.GetReason]"
		}
		min_width = 535
		max_width = 535
		multiline = yes
		using = default_list_position
		align = nobaseline
		margin = { 15 15 }

		background = {
			using = entry_bg
		}
	}

	type coe_concert_of_europe_buttons = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		using = entry_bg_fancy
		spacing = 10
		margin_bottom = 20

		visible = "[Not( IsDataModelEmpty( JournalEntry.GetScriptedButtons ) )]"

		default_header_clean_faded = {
			parentanchor = hcenter
			blockoverride "text" {
				text = "com_gui_main_actions"
			}
			blockoverride "size" {
				size = { 532 45 }
			}
		}

		flowcontainer = {
			parentanchor = top|hcenter
			direction = vertical
			spacing = 5

			datamodel = "[JournalEntry.GetScriptedButtons]"

			item = {
				widget = {
					size = { 400 40 }
					coe_concert_of_europe_scripted_button = { }
				}
			}
		}
	}

	type coe_concert_of_europe_scripted_button = button {
		parentanchor = center
		using = default_button_action
		tooltip = "SCRIPTED_ACTION_TOOLTIP"
		enabled = "[IsValid( ScriptedButton.ExecuteEffect )]"
		onclick = "[Execute( ScriptedButton.ExecuteEffect )]"
		size = { 460 38 }
		margin = { 20 20 }

		widget = {
			visible = "[ScriptedButton.IsSelected]"
			size = { 100% 100% }

			background = {
				using = paper_bg
			}
		}

		textbox = {
			parentanchor = center
			align = nobaseline
			autoresize = yes
			max_width = 300
			elide = right
			fontsize_min = 14
			text = "[ScriptedButton.GetName]"
		}

		icon = {
			visible = "[ScriptedButton.IsSelected]"
			using = highlighted_square_selection
		}
	}

	type coe_concert_members = flowcontainer {
		direction = vertical
		parentanchor = top|hcenter
		minimumsize = { 540 -1 }
		#using = entry_bg_fancy
		#spacing = 0
		#margin_bottom = 0

		block "com_members_header" {
			default_header_clean_faded = {
				visible = "No"
				parentanchor = hcenter
				blockoverride "text" {
					text = "com_gui_members"
				}
				blockoverride "size" {
					size = { 532 45 }
				}
			}
		}
		default_header = {
			using = default_list_position
			blockoverride "text" {
				text = "COE_CONCERT_POWERS"
			}
		}
		flowcontainer = {
			parentanchor = hcenter
			datamodel = "[JournalEntry.GetInvolvedCountries]"
			direction = vertical
			#flipdirection = yes

			item = {
				flowcontainer = {
					direction = vertical
					concert_of_europe_leader = {

						concert_of_europe_sphere = {
							#datacontext = "[Country.GetRuler]"
							blockoverride "coe_sphere_header" {
								text = "COE_COUNTRY_INNER_SPHERE"
							}
							blockoverride "coe_sphere_toggle" {
								onclick = "[GetVariableSystem.Toggle('coe_inner_sphere_open')]"
							}
							blockoverride "coe_sphere_visible" {
								visible = "[GetVariableSystem.Exists('coe_inner_sphere_open')]"
							}
							blockoverride "coe_sphere_invisible" {
								visible = "[Not(GetVariableSystem.Exists('coe_inner_sphere_open'))]"
							}
							blockoverride "coe_sphere_datamodel" {
								datamodel = "[Country.MakeScope.GetList('coe_inner_sphere')]"
							}
							blockoverride "coe_sphere_right" {
								text = "COE_COUNTRY_INNER_SPHERE_SIZE"
							}
						}
						concert_of_europe_sphere = {
							#datacontext = "[Country.GetRuler]"
							blockoverride "coe_sphere_header" {
								text = "COE_COUNTRY_OUTER_SPHERE"
							}
							blockoverride "coe_sphere_toggle" {
								onclick = "[GetVariableSystem.Toggle('coe_outer_sphere_open')]"
							}
							blockoverride "coe_sphere_visible" {
								visible = "[GetVariableSystem.Exists('coe_outer_sphere_open')]"
							}
							blockoverride "coe_sphere_invisible" {
								visible = "[Not(GetVariableSystem.Exists('coe_outer_sphere_open'))]"
							}
							blockoverride "coe_sphere_datamodel" {
								datamodel = "[Country.MakeScope.GetList('coe_outer_sphere')]"
							}
							blockoverride "coe_sphere_right" {
								text = "COE_COUNTRY_OUTER_SPHERE_SIZE"
							}
						}
					}
					
				}
				
			}
		}
	}

	type concert_of_europe_leader = flowcontainer {
		parentanchor = hcenter
		direction = vertical
		#visible = "[Or(Not(GetVariableSystem.Exists('coe_spheres_open')),GetVariableSystem.HasValue('coe_spheres_open', Country.GetName))]"
		using = entry_bg_fancy
		margin_bottom = 5
		flowcontainer = {	
			parentanchor = hcenter
			direction = vertical
			background = {
				visible = "[Country.IsLocalPlayer]"
				using = fade_left_simple
				modify_texture = {
					texture = "gfx/interface/masks/fade_vertical_bottom.dds"
					spriteType = Corneredstretched
					blend_mode = alphamultiply
					spriteborder_bottom = -50
				}
	
				using = fancy_pattern
				color = "[Country.GetMapColor]"
				using = frame_small_mask
			}
	
			# Name header
			container = {
				minimumsize = { @panel_width_minus_10 35 }
				section_header_button = {
					blockoverride "background" {}
					blockoverride "layout" {
						size = { 100% 100% }
					}
					blockoverride "onclick" {
						#onclick = "[GetVariableSystem.Set('coe_spheres_open',Country.GetName)]"
					}
					blockoverride "onclick_showmore" {
						visible = "[Not(GetVariableSystem.HasValue('coe_spheres_open', Country.GetName))]"
					}
					blockoverride "onclick_showless" {
						visible = "[GetVariableSystem.HasValue('coe_spheres_open', Country.GetName)]"
					}
					blockoverride "left_textbox" {}
				}
				button = {
					size = { 100% 100% }
					visible = "[Not(GetVariableSystem.HasValue('coe_spheres_open', Country.GetName))]"
					onclick = "[GetVariableSystem.Set('coe_spheres_open',Country.GetName)]"
				}
				button = {
					size = { 100% 100% }
					visible = "[GetVariableSystem.HasValue('coe_spheres_open', Country.GetName)]"
					onclick = "[GetVariableSystem.Clear('coe_spheres_open')]"
				}
				background = {
					using = fade_top_entry_header_colored
					color = "[Country.GetMapColor]"
				}
	
				flowcontainer = {
					position = { 75 0 }
					parentanchor = vcenter
					spacing = 5
	
					textbox = {
						parentanchor = vcenter
						multiline = yes
						autoresize = yes
						align = nobaseline
						elide = right
						fontsize_min = 12
						max_width = 250
						text = "POWER_BLOC_MEMBER_COUNTRY_NAME"
					}
	
					button_icon_goto = {
						size = { 26 26 }
						tooltip = "GO_TO_BUTTON_COUNTRY"
						onclick = "[InformationPanelBar.OpenCountryPanelTab( Country.Self, 'default' )]"
					}
				}
	
				rank_badge = {
					size = { 45 45 }
					position = { 30 -5 }
	
					blockoverride "font_size_under_100_rank" {
						using = fontsize_medium
					}
				}
				flowcontainer = {
					visible = "[Not(Country.IsLocalPlayer)]"
					position = { -8 2 }
					parentanchor = right|vcenter
					spacing = 5

					# Zoom-to button
					widget = {
						parentanchor = vcenter
						size = { 28 28 }

						button_icon_zoom = {
							size = { 100% 100% }

							block "goto_properties" {
								onclick = "[Country.AccessCapital.ZoomToCapital]"
								tooltip = "ZOOM_TO_COUNTRY_CAPITAL"
								enabled = "[Not( Country.GetCapital.IsZoomingToCapital )]"
							}
						}
					}

				}
			}
	
			widget = {
				parentanchor = hcenter
				size = { 500 90 }
	
				fancy_flag_ui = {
					parentanchor = vcenter
					size = { 80 60 }
	
					blockoverride "overlay_button_and_bg_glow_position" {
						position = { -9 -4 }
					}
	
					blockoverride "rank_badge_block" {}
				}
	
				flowcontainer = {
					parentanchor = vcenter
					position = { 100 0 }
					direction = vertical
					spacing = 7
	
					flowcontainer = {
						parentanchor = hcenter
						spacing = @grid_spacing
	
						### PRESTIGE
						power_bloc_header_grid_item = {
							using = tooltip_se
							tooltip = "COUNTRY_PRESTIGE_BREAKDOWN"
	
							blockoverride "text" {
								raw_text = "#v [Country.GetPrestige]#!"
							}
	
							blockoverride "icon" {
								raw_text = "@prestige!"
							}
						}
	
						### TOTAL GDP
						power_bloc_header_grid_item = {
							using = tooltip_se
							using = GDP_tooltip_with_graph
	
							blockoverride "text" {
								raw_text = "#v [Country.GetGDP|D]#!"
							}
	
							blockoverride "icon" {
								raw_text = "@gdp!"
							}
						}
	
						### TOTAL NUMBER OF BATTALIONS
						power_bloc_header_grid_item = {
							using = tooltip_se
							tooltip = "PANEL_MILITARY_ARMY_OVERVIEW_TOOLTIP"
	
							blockoverride "text" {
								raw_text = "[Country.GetRegularBattalions|v] + [Country.CalcConscriptableBattalions|v]"
							}
	
							blockoverride "icon" {
								raw_text = "@battalions!"
							}
						}
	
					}
	
					flowcontainer = {
						spacing = @grid_spacing
						parentanchor = hcenter
	
						### LEVERAGE ON THE LEADER
						power_bloc_header_grid_item = {
							using = tooltip_se
							tooltip = "COE_SPHERELINGS_TOTAL"
	
							blockoverride "text" {
								text = "[Add_int32(GetDataModelSize(Country.MakeScope.GetList('coe_inner_sphere')), GetDataModelSize(Country.MakeScope.GetList('coe_outer_sphere')) )]"
								default_format = "#variable"
							}
	
							blockoverride "icon" {
								raw_text = "@leverage!"
							}
						}
	
						### INFAMY
						power_bloc_header_grid_item = {
							using = tooltip_se
							tooltip = "[Country.GetInfamyDesc]"
	
							blockoverride "text" {
								raw_text = "#v [Country.GetInfamy|1-]#!"
							}
	
							blockoverride "whole_icon" {
								icon = {
									size = { 30 30 }
									position = { -10 0 }
									texture = "[Country.GetInfamyIconTexture]"
								}
							}
						}
	
						### TOTAL NUMBER OF SHIPS
						power_bloc_header_grid_item = {
							using = tooltip_se
							tooltip = "PANEL_MILITARY_NAVY_CURRENT_SHIPS_TOOLTIP"
	
							blockoverride "text" {
								raw_text = "#v [Country.GetNumShips|0]#!"
							}
	
							blockoverride "icon" {
								raw_text = "@ships!"
							}
						}
					}
				}
	
				flowcontainer = {
					visible = "[Or(Not(IsDataModelEmpty(Country.GetAllOverlordDiploActions)), Not(IsDataModelEmpty(Country.GetAllSubjectDiploActions)))]"
					parentanchor = right|vcenter
					spacing = 10
	
					flowcontainer = {
						direction = vertical
						parentanchor = vcenter
	
						### OVERLORD ACTIONS
						diplo_actions_button = {
							visible = "[Country.IsSubjectOf(GetPlayer.Self)]"
							size = { 38 38 }
	
							blockoverride "onclick" {
								onclick = "[RightClickMenuManager.ToggleOverlordActions(Country.AccessSelf, PdxGuiWidget.AccessSelf)]"
							}
	
							blockoverride "tooltip" {
								tooltip = "OVERLORD_ACTIONS_BUTTON_TOOLTIP"
							}
	
							blockoverride "icon_texture" {
								texture = "gfx/interface/buttons/button_icons/overlord_interaction.dds"
							}
	
							blockoverride "available_number_text" {
								text = "[GetDataModelSize(Country.GetAvailableOverlordDiploActions)|+]"
							}
						}
	
						### SUBJECT ACTIONS
						diplo_actions_button = {
							visible = "[GetPlayer.IsSubjectOf(Country.Self)]"
							size = { 38 38 }
						}
					}
				}
			}
		}
	}
	type concert_of_europe_sphere = panel_dropdown {
		visible = "[GetVariableSystem.HasValue('coe_spheres_open', Country.GetName)]"
		#direction = vertical
		#section_header_button = {
			#parentanchor = hcenter
			blockoverride "section_header_left_text" {
				block "coe_sphere_header" {
					text = "COE_COUNTRY_SPHERE"
				}
			}
			blockoverride "section_header_right_text" {
				block "coe_sphere_right" {
					text = "[GetDataModelSize(Country.MakeScope.GetList('coe_sphere'))]"
				}
			}
			blockoverride "section_header_size" {
				color = "[Country.GetMapColor]"
				size = { @panel_width_minus_10 38 }
			}
			
			blockoverride "onclick" {
				block "coe_sphere_toggle" {
					onclick = "[GetVariableSystem.Toggle('coe_sphere_open')]"
				}
			}
			blockoverride "onclick_showmore" {
				block "coe_sphere_invisible" {
					visible = "[Not(GetVariableSystem.Exists('coe_sphere_open'))]"
				}
			}

			blockoverride "onclick_showless" {
				block "coe_sphere_visible" {
					visible = "[GetVariableSystem.Exists('coe_sphere_open')]"
				}
			}
		#}
			blockoverride "items_parentanchor" {
				parentanchor = hcenter
			}
			blockoverride "items_visibility" {
				block "coe_sphere_visible" {
					visible = "[GetVariableSystem.Exists('coe_sphere_open')]"
				}
			}
			blockoverride "dropdown_datamodel" {
				block "coe_sphere_datamodel" {
					datamodel = "[Country.MakeScope.GetList('coe_sphere')]"
				}
			}
			blockoverride "item" {	
				concert_of_europe_sphere_item = {}
			}
			blockoverride "empty_state_visibility" { visible = "No" }
			blockoverride "second_list" {}
			
		
	}
	
